# Copy to .env (in this folder, next to groups.json). Every setting is optional; see CLAUDE.md → "Setting up".

# Where the site's data lives. Leave empty to keep it in a database on this computer (started automatically).
# Set it to a hosted Postgres (Neon, Supabase, RDS, …) when the site runs online, e.g. on Vercel:
#   DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Add &schema=<name> to use a schema other than "public".
DATABASE_URL=

# Google sign-in. Leave all three empty for open mode: no login, and every page (admin included) is public.
# AUTH_SECRET: any long random string (`npx auth secret` prints one).
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: an OAuth client from Google Cloud Console → APIs & Services → Credentials,
# with redirect URI <site>/api/auth/callback/google.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# With sign-in on, only verified Google accounts on this domain can sign in (e.g. example.com). Required then.
AUTH_ALLOWED_EMAIL_DOMAIN=
